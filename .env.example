# Banco de dados (obrigatório — usado pelo Prisma e em runtime)
# Padrão local de desenvolvimento (veja docker-compose.yml)
DATABASE_URL="postgresql://backup_service:backup_service_dev@localhost:5432/backup_service"

# Opcionais -----------------------------------------------------------------

# Binário do rclone. Se não definido, usa o binário embutido em node_modules/rclone.js
# RCLONE_EXECUTABLE="/usr/local/bin/rclone"

# Caminho do arquivo de configuração do rclone.
# Se não definido, usa um arquivo temporário em os.tmpdir()/backup-service-rclone.conf
# RCLONE_CONFIG_PATH="/etc/rclone/rclone.conf"

# Nome do remote padrão usado pelo worker de backup
# DEFAULT_RCLONE_REMOTE="gdrive"

# Caminho de armazenamento dos backups (padrão: /backups)
# STORAGE_BACKUP_PATH="/backups"